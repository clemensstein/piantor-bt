#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include "keys_de.h"

/ {
    chosen { zmk,physical-layout = &default_layout; };
};

/ {
    behaviors {
        HMR: HMR {
            compatible = "zmk,behavior-hold-tap";
            label = "HMR";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            hold-trigger-key-positions = <1 15 2 3 4 16 5 17 29 28 26 14 27 13 25 24 12 36 37 38 0>;
            hold-trigger-on-release;
            tapping-term-ms = <250>;
            flavor = "tap-preferred";
            require-prior-idle-ms = <100>;
        };

        HML: HML {
            compatible = "zmk,behavior-hold-tap";
            label = "HML";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            hold-trigger-key-positions = <6 7 8 9 10 11 18 19 20 21 22 23 30 31 32 33 34 35 40 41 39>;
            hold-trigger-on-release;
            tapping-term-ms = <250>;
            flavor = "tap-preferred";
            require-prior-idle-ms = <100>;
        };

        // Layer 1: Ziffer normal, mit Strg -> F-Taste. Das Strg wird beim
        // Morph entfernt (keep-mods = 0 als Default), es kommt reines Fn an.
        // Shift+Zahl bleibt damit frei fuer die Symbole (z. B. $ = Shift+4).

        mm_f1: mm_f1 {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp DE_N1>, <&kp F1>;

            mods = <(MOD_LCTL|MOD_RCTL)>;
        };

        mm_f2: mm_f2 {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp DE_N2>, <&kp F2>;

            mods = <(MOD_LCTL|MOD_RCTL)>;
        };

        mm_f3: mm_f3 {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp DE_N3>, <&kp F3>;

            mods = <(MOD_LCTL|MOD_RCTL)>;
        };

        mm_f4: mm_f4 {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp DE_N4>, <&kp F4>;

            mods = <(MOD_LCTL|MOD_RCTL)>;
        };

        mm_f5: mm_f5 {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp DE_N5>, <&kp F5>;

            mods = <(MOD_LCTL|MOD_RCTL)>;
        };

        mm_f6: mm_f6 {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp DE_N6>, <&kp F6>;

            mods = <(MOD_LCTL|MOD_RCTL)>;
        };

        mm_f7: mm_f7 {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp DE_N7>, <&kp F7>;

            mods = <(MOD_LCTL|MOD_RCTL)>;
        };

        mm_f8: mm_f8 {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp DE_N8>, <&kp F8>;

            mods = <(MOD_LCTL|MOD_RCTL)>;
        };

        mm_f9: mm_f9 {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp DE_N9>, <&kp F9>;

            mods = <(MOD_LCTL|MOD_RCTL)>;
        };

        mm_f10: mm_f10 {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp N0>, <&kp F10>;

            mods = <(MOD_LCTL|MOD_RCTL)>;
        };
    };

    macros {
        open_terminal: open_terminal {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&none>;
            label = "OPEN_TERMINAL";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "QWERTZ";

            // --------------------------------------------------------------------------------
            // |  TAB |  Q  |  W  |  E  |  R  |  T  |  Y  |  U   |  I  |  O  |  P  | BSPC |
            // | CTRL |  A  |  S  |  D  |  F  |  G  |  H  |  J   |  K  |  L  |  ;  |  '   |
            // | SHFT |  Z  |  X  |  C  |  V  |  B  |  N  |  M   |  ,  |  .  |  /  | ESC  |
            //                    | GUI | LWR | SPC | ENT | RSE  | ALT |

            bindings = <
&kp TAB  &kp DE_Q  &kp DE_W  &kp DE_E  &kp DE_R  &kp DE_T  &kp DE_Z  &kp DE_U  &kp DE_I  &kp DE_O  &kp DE_P  &kp DE_U_UMLAUT  &kp ESCAPE  &HML LEFT_ALT DE_A  &HML LCTRL S  &kp DE_D  &kp DE_F  &kp DE_G  &kp DE_H  &kp DE_J  &kp DE_K  &HMR RCTRL L  &HMR LEFT_ALT DE_O_UMLAUT  &kp DE_A_UMLAUT  &kp LEFT_SHIFT  &kp DE_Y  &kp DE_X  &kp DE_C  &kp DE_V  &kp DE_B  &kp DE_N  &kp DE_M  &kp DE_COMMA  &kp DE_DOT  &kp DE_MINUS  &kp RIGHT_SHIFT  &lt 1 BACKSPACE  &lt 2 SPACE  &lt 3 DELETE  &kp LWIN  &lt 2 ENTER  &mo 1
            >;
        };

        lower_layer {
            display-name = "NUMBER";

            // -----------------------------------------------------------------------------------------
            // |  TAB |  1  |  2  |  3  |  4  |  5    |  6  |  7  |  8  |  9  |  0  | BSPC |
            // | CTRL | BT1 | BT2 | BT3 | BT4 | BT5   | LFT | DWN |  UP | RGT |     |      |
            // | SHFT | BTCR| RGB | RST | BOOT| Unlock|     |     |     |     |     |      |
            //                    | GUI |     | SPC   | ENT |     | ALT |

            bindings = <
&kp C_NEXT  &mm_f1  &mm_f2  &mm_f3  &mm_f4  &mm_f5  &mm_f6  &mm_f7  &mm_f8  &mm_f9  &mm_f10  &kp DE_ESZETT  &kp C_PLAY_PAUSE  &none  &none  &kp LC(LS(LEFT_ARROW))  &kp LC(LS(RIGHT))  &none  &kp LEFT  &kp DOWN  &kp UP  &kp RIGHT  &none  &kp C_VOLUME_UP  &kp C_PREV  &none  &kp HOME  &kp PAGE_UP  &kp PAGE_DOWN  &kp END  &none  &none  &kp DE_COMMA  &kp DE_DOT  &kp DE_MINUS  &kp C_VOLUME_DOWN  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        raise_layer {
            display-name = "SYMBOL";

            // -----------------------------------------------------------------------------------------
            // |  TAB |  !  |  @  |  #  |  $  |  %  |  ^  |  &  |  *  |  (  |  )  | BSPC |
            // | CTRL |     |     |     |     |     |  -  |  =  |  [  |  ]  |  \  |  `   |
            // | SHFT |     |     |     |     |     |  _  |  +  |  {  |  }  | "|" |  ~   |
            //                    | GUI |     | SPC | ENT |     | ALT |

            bindings = <
&none  &kp DE_EXCLAMATION  &kp DE_DOUBLE_QUOTES  &kp DE_SECTION  &kp DE_DOLLAR  &kp DE_PERCENT  &kp DE_AMPERSAND  &kp DE_SLASH  &kp DE_LEFT_PARENTHESIS  &kp DE_RIGHT_PARENTHESIS  &kp DE_EQUAL  &kp DE_QUESTION  &none  &none  &kp DE_PIPE  &kp DE_GRAVE  &kp DE_TILDE  &none  &kp DE_LEFT_BRACKET  &kp DE_LEFT_BRACE  &kp DE_RIGHT_BRACE  &kp DE_RIGHT_BRACKET  &kp DE_BACKSLASH  &kp K_MUTE  &none  &none  &kp DE_AT  &kp DE_CARET  &kp DE_APOS  &none  &kp DE_HASH  &kp DE_PLUS  &kp DE_LESS_THAN  &kp DE_GREATER_THAN  &kp DE_M  &kp CAPSLOCK  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        extra_layer_1 {
            display-name = "EXTRA 1";
            bindings = <
&none  &none  &kp DE_N7  &kp DE_N8  &kp DE_N9  &none  &none  &kp DE_N7  &kp DE_N8  &kp DE_N9  &none  &kp LC(LS(ESCAPE))  &none  &none  &kp DE_N4  &kp DE_N5  &kp DE_N6  &none  &none  &kp DE_N4  &kp DE_N5  &kp DE_N6  &none  &none  &none  &none  &kp DE_N1  &kp DE_N2  &kp DE_N3  &kp DE_N0  &kp DE_N0  &kp DE_N1  &kp DE_N2  &kp DE_N3  &none  &none  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        extra_layer_2 {
            display-name = "EXTRA 2";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        extra_layer_3 {
            display-name = "EXTRA 3";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        extra_layer_4 {
            display-name = "EXTRA 4";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        extra_layer_5 {
            display-name = "EXTRA 5";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        extra_layer_6 {
            display-name = "EXTRA 6";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        layer_9 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };
    };
};
